# Database (shared with CRM)
DATABASE_URL="postgresql://user:password@localhost:5432/wavelaunch"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://127.0.0.1:3007"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3007"

# API URLs
CRM_API_URL="http://localhost:3000"
BLUEPRINT_ENGINE_URL="http://localhost:3010"

# Claude AI
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Email (optional - uses CRM email service)
# RESEND_API_KEY="re-your-key-here"

# Instantly (Replies sync)
# IMPORTANT: keep this in .env.local (do not commit).
INSTANTLY_API_KEY="your-instantly-api-key"

# AI provider
# - "zai": call z.ai directly (no local proxy needed)
# - "proxy": call a local proxy (ai-proxy-server.js)
AI_PROVIDER="zai"

# z.ai API key (monthly subscription) for GLM-4.7
# IMPORTANT: keep this in .env.local (do not commit).
GLM_API_KEY="your-zai-api-key"

# Optional: local AI proxy URL (only used when AI_PROVIDER="proxy" OR no GLM_API_KEY is provided)
AI_PROXY_URL="http://localhost:3003"

# Optional: AI request timeout (ms)
AI_TIMEOUT_MS="60000"

# Optional: auto-import a default playbook into the reply agent on first run
REPLY_AGENT_GUIDE_PATH="/Users/arunav/Downloads/d26_lead_management_system.md"

# Optional: replies worker base URL (the Next dev server URL)
REPLIES_WORKER_BASE_URL="http://127.0.0.1:3007"

# Optional: pull intake submissions into the dashboard (used by Settings → Sync)
VISION_FORM_SOURCE_URL="http://localhost:3000"

# If the source is `login.wavelaunch.org` (admin-only), you need the CRM's EXTERNAL_API_TOKEN:
VISION_FORM_EXTERNAL_TOKEN="your-crm-external-api-token"

# Optional: if the source is behind auth AND you don't want to deploy an external list endpoint,
# the dashboard can pull submissions directly from the CRM database.
# In local dev, this also auto-falls back to `../crm/.env` if present.
# VISION_FORM_SOURCE_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Optional: secure the inbound webhook from the apply app (apps/apply → workflow-dashboard)
# VISION_FORM_WEBHOOK_SECRET="set-a-shared-secret"

# Optional: auto-sync from Vision Form on the workflow worker
# VISION_FORM_AUTO_SYNC="1"                 # set "0" to disable
# VISION_FORM_SYNC_INTERVAL_MS="300000"     # default 5 minutes

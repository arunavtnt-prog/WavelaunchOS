// Blueprint Generation Enums
enum BlueprintStage {
  // Batch 1: Market Research (parallel)
  MARKET_SIZING
  COMPETITIVE_INTELLIGENCE
  INDUSTRY_TRENDS
  // Batch 2: Brand Analysis (parallel, after Batch 1)
  AUDIENCE_DEEP_DIVE
  BRAND_POSITIONING
  // Batch 3: Product & Financials (parallel, after Batch 1-2)
  PRODUCT_ARCHITECTURE
  FINANCIAL_PROJECTIONS
  // Batch 4: Strategy (parallel, after Batch 1-3)
  GO_TO_MARKET
  OPERATIONAL_FRAMEWORK
  IMPLEMENTATION_ROADMAP
  // Final: Synthesis (sequential)
  EXECUTIVE_SUMMARY
  // Compilation
  COMPILATION
}

enum BlueprintResearchStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED
  REVIEW_REQUIRED
  APPROVED
}


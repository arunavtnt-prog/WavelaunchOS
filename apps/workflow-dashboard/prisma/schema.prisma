  TIMELINE_CONCERNS
  SKEPTICISM_CONCERNS
  COMPETITION_QUESTIONS
  REVENUE_SHARING_OBJS
  CONTRACT_QUESTIONS
  PAYMENT_QUESTIONS
  LONGTERM_QUESTIONS
  // NEW: Vision form follow-up intents
  VISION_VAGUE
  VISION_INCOMPLETE
  VISION_TECH_ISSUE
  // NEW: Roadmap response intents
  ROADMAP_CHANGES_REQUESTED
  ROADMAP_UNSURE_DIRECTION
  ROADMAP_COMPETITOR_ANALYSIS
}

enum ContactKind {
  CLIENT
  LEAD
  PIPELINE
  OTHER
}

enum ConversationStage {
  INITIAL_CONTACT
  VISION_FORM_SENT
  VISION_FORM_COMPLETE
  ROADMAP_DELIVERED
  VC_SUBMITTED
  VC_APPROVED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETE
}

// Workflow Automation Models
model WorkflowState {
  id                    String         @id @default(cuid())
  applicationId         String         @unique
  application           Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  // Current state in workflow
  status                WorkflowStatus @default(SUBMITTED)
  statusHistory         Json[]         @default([])

  // Snapshot generation
  snapshotMarkdown      String?
  snapshotPdfPath       String?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  generationError       String?

  // Email workflow
  draftEmailSubject     String?
  draftEmailBody        String?
  draftEmailPreparedAt  DateTime?
  emailSentAt           DateTime?
  emailSentBy           String?
  
  // Follow-up tracking
  followUpCount         Int            @default(0)
  lastFollowUpAt        DateTime?
  nextFollowUpAt        DateTime?
  
  // Snapshot file reference
  snapshotFilePath      String?
  snapshotVersion       Int            @default(1)
  
  // Timestamps
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  // Relations
  auditLogs             WorkflowAuditLog[]
  emailDrafts           EmailDraft[]
  
  @@index([status])
  @@index([nextFollowUpAt])
  @@map("workflow_states")
}

model WorkflowAuditLog {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    WorkflowState @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  action      String   // GENERATE_BLUEPRINT, PREPARE_EMAIL, SEND_EMAIL, etc.
  performedBy String?  // User ID or 'SYSTEM'
  oldStatus   String?
  newStatus   String?
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now())
  
  @@index([workflowId])
  @@index([createdAt])
  @@map("workflow_audit_logs")
}

model EmailDraft {
  id              String      @id @default(cuid())
  workflowId      String
  workflow        WorkflowState @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  blueprintId     String?     // Link to blueprint if this is a blueprint approval email
  blueprint       Blueprint?  @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  subject         String
  body            String
  attachments     Json[]      @default([]) // Array of {filename, path, mimeType}

  // Review status
  status          DraftStatus @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?

  // Send tracking
  sentAt          DateTime?
  sentBy          String?

  // Automation tracking
  autoGenerated   Boolean     @default(false) // true for automatically generated drafts

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([workflowId])
  @@index([blueprintId])
  @@map("email_drafts")
}

model InstantlyConversation {
  id                     String   @id @default(cuid())
  providerConversationId  String?  @unique
  campaignId              String?
  campaignName            String?
  mailboxEmail            String?
  leadEmail               String
  leadName                String?
  leadCompany             String?
  category                String?
  leadType                LeadType @default(COLD)
  leadTypeManualOverride  LeadType?
  intent                  ReplyIntent?
  pipelineSuggested       Boolean  @default(false)
  needsReply              Boolean  @default(false)
  summaryText             String?
  lastAiProcessedAt       DateTime?
  lastInboundAt           DateTime?
  lastMessageAt           DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // NEW: Track conversation stage in funnel
  conversationStage       ConversationStage @default(INITIAL_CONTACT)
  stageUpdatedAt         DateTime @default(now())

  messages                InstantlyMessage[]
  drafts                  ReplyDraft[]

  @@index([leadEmail])
  @@index([campaignId])
  @@index([lastMessageAt])
  @@map("instantly_conversations")
}

model InstantlyCampaign {
  id                 String   @id @default(cuid())
  providerCampaignId String   @unique
  name               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([providerCampaignId])
  @@map("instantly_campaigns")
}

model ReplyCampaignPolicy {
  id                 String   @id @default(cuid())
  providerCampaignId String   @unique
  policyKey          String
  allowCalls         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([providerCampaignId])
  @@index([policyKey])
  @@map("reply_campaign_policies")
}

model ReplyPlaybook {
  id        String  @id @default(cuid())
  key       String  @unique
  name      String
  version   Int     @default(1)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  ReplyPlaybookSection[]

  @@index([key])
  @@map("reply_playbooks")
}

model ReplyPlaybookSection {
  id         String      @id @default(cuid())
  playbookId String
  playbook   ReplyPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  content    String
  intents    ReplyIntent[] @default([])
  leadTypes  LeadType[]    @default([])
  keywords   String[]      @default([])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([playbookId, order])
  @@map("reply_playbook_sections")
}

model Contact {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String?
  kind      ContactKind @default(OTHER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([kind])
  @@map("contacts")
}

model InstantlyMessage {
  id                String               @id @default(cuid())
  conversationId     String
  conversation       InstantlyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId  String?              @unique
  providerServerMessageId String?
  ueType             Int?
  emailType          String?
  direction          ReplyMessageDirection
  fromEmail          String?
  toEmail            String?
  subject            String?
  bodyHtml           String?
  bodyText           String
  isUnread           Boolean              @default(false)
  isFocused          Boolean              @default(false)
  receivedAt         DateTime             @default(now())
  raw                Json?

  @@index([conversationId, receivedAt])
  @@map("instantly_messages")
}

model ReplyDraft {
  id              String           @id @default(cuid())
  conversationId  String
  conversation    InstantlyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subject         String
  body            String
  status          ReplyDraftStatus @default(PENDING_REVIEW)
  model           String?
  prompt          String?
  rawResponse     String?
  tokensUsed      Int?
  confidence      Float?
  category        String?
  sentMessageId   String?
  autoSent        Boolean          @default(false)
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([conversationId])
  @@index([status])
  @@index([sentMessageId])
  @@map("reply_drafts")
}

model ExecutionLog {
  id              String    @id @default(cuid())
  executionType   String    // MANUAL_RUN, RETRY, etc.
  startedAt       DateTime
  completedAt     DateTime?
  status          String    // RUNNING, COMPLETED, FAILED
  itemsProcessed  Int       @default(0)
  itemsFailed     Int       @default(0)
  errorMessage    String?
  logData         Json?     // Detailed processing log
  triggeredBy     String?   // User who triggered (or 'SYSTEM')

  @@index([startedAt])
  @@index([status])
  @@map("execution_logs")
}

// Blueprint Generation Models
model Blueprint {
  id              String                  @id @default(cuid())
  applicationId   String                  @unique
  application     Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Overall status
  status          BlueprintResearchStatus @default(PENDING)
  currentBatch    Int                     @default(1)
  progress        Float                   @default(0)

  // Generated content
  markdown        String?                 // Final compiled blueprint
  pdfPath         String?

  // Generation metadata
  startedAt       DateTime?
  completedAt     DateTime?
  lastStageAt     DateTime?

  // Token usage tracking
  totalTokensUsed Int                     @default(0)
  totalSearchQueries Int                  @default(0)

  // Relationships
  researchStages  BlueprintResearch[]
  emailDrafts     EmailDraft[]            // Approval emails for this blueprint

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status])
  @@index([currentBatch])
  @@map("blueprints")
}

model BlueprintResearch {
  id              String                  @id @default(cuid())
  blueprintId     String
  blueprint       Blueprint               @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  // Stage info
  stage           BlueprintStage
  batch           Int                     // Which batch (1-4) or 5 for final
  status          BlueprintResearchStatus @default(PENDING)

  // Content
  prompt          String?                 // What was sent to AI (set when processing)
  response        String?                 // AI raw response
  markdown        String?                 // Formatted markdown for final doc
  sectionNumber   Int?                    // Which section this contributes to (1-10)

  // Research metadata
  metadata        Json?                   // Sources, search queries, data points
  sources         BlueprintSource[]

  // Retry logic
  attempts        Int                     @default(0)
  error           String?

  // Timestamps
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([blueprintId, stage])
  @@index([status])
  @@index([batch])
  @@map("blueprint_research")
}

model BlueprintSource {
  id              String   @id @default(cuid())
  researchId      String
  research        BlueprintResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  // Source info
  type            String   // "web_search", "api", "report", "framework"
  url             String?
  title           String?
  author          String?
  publishedAt     DateTime?

  // Extracted data
  keyPoints       Json?
  quotes          String[]
  dataPoints      Json?    // Numbers, stats, figures

  // Citation info
  citation        String?  // Formatted citation for final doc

  // Credibility
  relevanceScore  Float?

  createdAt       DateTime @default(now())

  @@map("blueprint_sources")
}
